# Local stack configuration. See .env.example for every knob and its default.

# The three Form Builder apps live in one directory as real checkouts. ./apps holds symlinks to
# them, which is fine for the host tools but not for Docker: a bind mount carries the symlink, not
# its target, so /apps inside the container would be three broken links and Fact Explorer would
# discover no apps at all. Point it at the directory that actually holds them.
TAXPERT_APPS_DIR=/Users/f3bxb/form-builder-examples
