# LiteLLM model string — prefix selects the provider.
# Examples: ollama/llama3.1:8b | anthropic/claude-sonnet-4-6 | openai/gpt-4o
LLM_MODEL=ollama/llama3.1:8b

# Optional model override for the /scenario/generate route. Emitting an exact fact-graph
# serialization benefits from a stronger model. Falls back to LLM_MODEL when unset.
# SCENARIO_LLM_MODEL=anthropic/claude-sonnet-4-6

# Ollama: base URL of a running Ollama instance (used when LLM_MODEL starts with ollama/)
OLLAMA_API_BASE=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=irs_publications
# JSON array of origins allowed to query ChromaDB directly (e.g. chromadb-admin on port 3001)
CHROMA_SERVER_CORS_ALLOW_ORIGINS=["http://localhost:3001"]
FACT_DICTIONARY_URL=http://localhost:3003/app/eitc/resources/fact-dictionary.xml
# Directories the scenario generator reads (existing scenarios to clone + flow XML to review).
# The application lives in its own repository; these resolve relative to services/assistant/ (where
# `make dev` runs) and assume it is checked out under the repo's apps/ directory. See apps/README.md.
SCENARIOS_DIR=../../apps/credit-assistant/src/main/resources/credit-assistant/scenarios
FLOW_DIR=../../apps/credit-assistant/src/main/resources/credit-assistant/flow
# Comma-separated CORS allow-list. Include the credit-assistant (:3003) and Fact Explorer (:5180).
FRONTEND_ORIGIN=http://localhost:3003,http://localhost:5180
PDF_DIR=data/irs_publications
HTML_DIR=data/html
