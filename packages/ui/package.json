  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "lint": "eslint",
    "format": "eslint --fix"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
