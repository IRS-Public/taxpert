    "./tools-modal": "./src/tool-panels/js/taxpert-tools-modal.js",
    "./tool-layout": "./src/tool-panels/js/tool-layout.js",
    "./tool-registry": "./src/tool-panels/js/tool-registry.js",
    "./inspect": "./src/tool-panels/js/taxpert-inspect.js",
    "./inspect-selection": "./src/tool-panels/js/inspect-selection.js",
