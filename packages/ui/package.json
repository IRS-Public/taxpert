{
  "name": "taxpert",
  "version": "0.1.0",
  "description": "The Taxpert workspace: the framework-agnostic UI harness laid over a Form Builder app to make it understandable \u2014 global nav, audit panel, tool panels. Ships as raw ESM + CSS so it can be consumed with or without a bundler.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
