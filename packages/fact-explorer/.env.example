# Which FGM data source the loader reads (see src/model/load.js).
#   mock    -> public/data/form-builder-graph.mock.json   (hand-authored S0 fixture, app-agnostic)
#   real    -> the selected app's graph: its own {basePath}/resources/form-builder-graph.json when the
#              app serves one (--formBuilderGraph), else public/data/<app>/form-builder-graph.json
#   overlay -> real slices overlaid on mock, per-slice fallback (incremental de-mocking)
# Copy to .env.local and edit. Default when unset: mock.
VITE_FGM_SOURCE=mock

# Scenario overlay (N1–N6). The dev server proxies each Form Builder app's base path to that app's dev
# server, so its Scala.js engine bundle, fact dictionary and scenario JSONs are same-origin with
# fact-explorer (no CORS) and can share sessionStorage with an embedded iframe. The proxy table is
# derived from every fact-explorer.app.json beside this checkout — there is nothing to list here.
#
# Each app must be running for its own overlay to work (`make dev` in that repo). Override one app's
# target with VITE_APP_ORIGIN_<ID>, where <ID> is its descriptor id upper-cased with - as _:
#   VITE_APP_ORIGIN_CREDIT_ASSISTANT=http://credit-assistant
#   VITE_APP_ORIGIN_TWE=http://localhost:3000
# (This replaced VITE_CA_ORIGIN, which could only ever name one app.)

# Feature flags (see src/config/featureFlags.js). Shared by name with the
# credit-assistant build flags so a feature can be hidden in both apps at once.
#
# The two AI features are flagged apart — generation writes a whole Fact Graph
# from a prompt, explanation only reads facts back — so each can be revealed on
# its own. Both default OFF until the backend prompt engineering is robust.
#
# aiFactExplanation: the "Explain & Analyze" chat dock, the per-node and
# DetailPanel "✨ Explain" buttons, and the scenario "✨ Explain" summary (which
# is an explain prompt through the same dock). Mirrors CA's --aiFactExplanation.
VITE_AI_FACT_EXPLANATION=false
#
# aiScenarioGeneration: the "Generate a scenario" section of the shared Manage
# scenario modal. Mirrors CA's --aiScenarioGeneration.
VITE_AI_SCENARIO_GENERATION=false
