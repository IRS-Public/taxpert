# Copy to .env for `docker compose`. Every value here has a working default in
# docker-compose.yml — this file exists to show you the knobs, not because the stack needs it.

# --- Where your Form Builder applications are -----------------------------------------------
# A directory holding one or more app repos, each with a fact-explorer.app.json at its root.
# Mounted read-only at /apps. See apps/README.md.
# TAXPERT_APPS_DIR=./apps

# How a container reaches your running app, base path included. Apps run in their own repository,
# not in this stack, so the default reaches one running natively on the host.
# TAXPERT_APP_HOST=http://host.docker.internal:3003/app/eitc

# Browser origins allowed to call the assistant: your app, and Fact Explorer.
# TAXPERT_FRONTEND_ORIGIN=http://localhost:3003,http://localhost:5180

# Scenario generation reads one app's scenarios/ and flow/ (paths inside the /apps mount).
# TAXPERT_SCENARIOS_DIR=/apps/credit-assistant/src/main/resources/credit-assistant/scenarios
# TAXPERT_FLOW_DIR=/apps/credit-assistant/src/main/resources/credit-assistant/flow

# --- The model (profile: ai) ------------------------------------------------------------------
# LiteLLM model string — the prefix selects the provider.
# Examples: ollama/llama3.1:8b | anthropic/claude-sonnet-4-6 | openai/gpt-4o
LLM_MODEL=ollama/llama3.1:8b
# Optional stronger model for /scenario/generate. Falls back to LLM_MODEL.
# SCENARIO_LLM_MODEL=anthropic/claude-sonnet-4-6
# Set the matching API key when LLM_MODEL is not an ollama/ one.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Ollama runs natively on the host, never containerized.
# OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
